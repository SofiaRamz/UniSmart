# ======================================================================
# UniSmart AI — variables de entorno. Copia este archivo como .env
# ======================================================================
APP_ENV=development
# Genera una clave: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=reemplaza-con-una-clave-larga-y-aleatoria

# PostgreSQL (docker-compose.yml expone el puerto 5432)
DATABASE_URL=postgresql+psycopg://unismart:unismart_dev_2026@localhost:5432/unismart

# Sesión: cookie HttpOnly. En producción con HTTPS usa COOKIE_SECURE=true
SESSION_COOKIE_NAME=unismart_session
SESSION_TTL_HOURS=8
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Solo si sirves el frontend con Vite en otro puerto (npm run dev usa proxy y no lo necesita)
CORS_ORIGINS=[]
TRUST_PROXY_HEADERS=false

# LM Studio: pestaña Developer → Start Server (puerto 1234)
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Identificador exacto que muestra LM Studio (botón "Copy model identifier")
LLM_MODEL=qwen3-4b-instruct-2507
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=700
LLM_TIMEOUT_SECONDS=120

# Embeddings locales: lmstudio | fastembed | hash (hash solo para pruebas)
EMBEDDING_PROVIDER=lmstudio
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_QUERY_PREFIX="search_query: "
EMBEDDING_DOC_PREFIX="search_document: "
# Con fastembed usa, por ejemplo:
# EMBEDDING_PROVIDER=fastembed
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_QUERY_PREFIX=
# EMBEDDING_DOC_PREFIX=
# auto: usa pgvector si está instalado; si no, arreglo de float y similitud en Python
VECTOR_BACKEND=auto

# RAG
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.40
RAG_MIN_KEYWORD_COVERAGE=0.5
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Archivos y OCR (Tesseract para PDF escaneados)
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=600
OCR_ENABLED=false
OCR_LANGUAGE=spa
# TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata

# Anti-abuso
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_REPORTS_PER_HOUR=5
RATE_LIMIT_LOGIN_PER_15_MIN=20
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
TIMEZONE=America/Mexico_City

# Solo para "python -m app.seed" (puedes omitirlas y el script las pide)
# SUPERADMIN_EMAIL=admin@tu-universidad.mx
# SUPERADMIN_PASSWORD=CambiaEsta2026
# DEMO_PASSWORD=Demo2026unismart
